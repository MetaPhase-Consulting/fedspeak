{
  "name": "@metaphase-tech/fedspeak",
  "version": "1.1.0",
  "description": "Federal Acronym Decoder — decode U.S. government acronyms from text or single lookups",
  "keywords": [
    "federal",
    "government",
    "acronyms",
    "decoder",
    "api",
    "mcp",
    "model-context-protocol",
    "ai"
  ],
  "author": "MetaPhase",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MetaPhase-Consulting/fedspeak.git"
  },
  "homepage": "https://fedspeak.dev",
  "bugs": {
    "url": "https://github.com/MetaPhase-Consulting/fedspeak/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/shared/mcp-server.js",
      "types": "./dist/shared/mcp-server.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "fedspeak-mcp": "dist/mcp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  }
}
